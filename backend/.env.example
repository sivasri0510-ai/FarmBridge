# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/farmbridge
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/farmbridge?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/farmbridge

# ── CORS ────────────────────────────────────────────────
# Vite dev server default. Comma-separate multiple origins.
FRONTEND_URL=http://localhost:5173

# ── Auth ────────────────────────────────────────────────
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ── Seed script only (ignored by the server) ────────────
ADMIN_EMAIL=admin@farmbridge.local
ADMIN_PASSWORD=replace_with_a_strong_password
